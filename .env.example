# 仅作为新建本地 .env 的模板。已经有 .env 时不要用此文件覆盖。

# 当前模型服务类型。此项目目前只支持 deepseek。
LLM_PROVIDER=deepseek

# DeepSeek API 密钥。请填写自己的密钥。
DEEPSEEK_API_KEY=

# DeepSeek Chat Completions 接口地址。通常保持此默认值。
DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions

# 阶段一：整份思维导图的全局摘要和模块摘要使用的模型。
# deepseek-flash 是当前官方模型 ID。
LLM_REASONING_MODEL=deepseek-flash

# 阶段一的思考强度，通过 API 的 reasoning_effort 参数传递。
# 可用值为 none、low、high、max。high 更重视全图关系归纳。
LLM_SUMMARY_REASONING_EFFORT=high

# 阶段二：逐个叶子测试点生成 CSV 用例使用的模型。
LLM_GENERATION_MODEL=deepseek-flash

# 阶段二的思考强度，通过 API 的 reasoning_effort 参数传递。
# 可用值为 none、low、high、max。low 通常响应更快。
LLM_GENERATION_REASONING_EFFORT=low

# 阶段一摘要请求允许生成的最大 token 数，默认也是 24000。
# 若输出摘要被截断，可提高此值；较大的上限可能增加输出用量。
LLM_PROJECT_SUMMARY_MAX_TOKENS=24000

# 以下为可选性能参数。未设置时使用注释中的默认值。

# 建立模型服务连接的超时秒数，默认 10 秒。
# LLM_CONNECT_TIMEOUT_SECONDS=10

# 生成单条测试用例请求的超时秒数，默认 90 秒。
# LLM_TIMEOUT_SECONDS=90

# 生成整图摘要请求的超时秒数，默认 180 秒。
# LLM_PROJECT_SUMMARY_TIMEOUT_SECONDS=180

# 每个模型请求失败后的最大尝试次数，默认 3 次。
# LLM_MAX_RETRIES=3

# 每个测试点生成用例时允许生成的最大 token 数，默认 4000。
# LLM_FULL_CASE_MAX_TOKENS=4000

# 当完整上下文超过此字符数时写日志提醒，不会截断上下文。默认 150000。
# LLM_CONTEXT_WARNING_CHARS=150000

# 仅当确认模型支持 JSON mode 时才设为 true，默认 false。
# ENABLE_LLM_JSON_MODE=false
